# Sanadi — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Values below are the LOCAL Supabase defaults printed by `supabase start`.

# ---------------------------------------------------------------------------
# Environment identity (leave unset in production)
# TEST turns on the staff "Sanadi Test Environment" banner and blocks email
# and any write to live university/partner systems. See docs/TEST_ENVIRONMENT.md
# ---------------------------------------------------------------------------
# SANADI_ENV="TEST"
# VITE_SANADI_ENV="TEST"

# ---------------------------------------------------------------------------
# Supabase — client (browser, must be VITE_ prefixed and publishable only)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<local anon key from `supabase start`>"
VITE_SUPABASE_PROJECT_ID="sanadi-local"

# ---------------------------------------------------------------------------
# Supabase — server (never exposed to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<local anon key>"
SUPABASE_SERVICE_ROLE_KEY="<local service_role key>"
SUPABASE_PROJECT_ID="sanadi-local"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin used in emails, QR codes and printed document verification links.
PUBLIC_APP_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# AI provider (required for the Assistant, CV parsing, speech-to-text)
# Default is the Lovable AI Gateway. Outside Lovable use one of the alternatives.
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=""
# OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_KEY=""
# CUSTOM_LLM_BASE_URL=""
# CUSTOM_LLM_API_KEY=""

# ---------------------------------------------------------------------------
# Email delivery (optional; sends are skipped when unset)
# ---------------------------------------------------------------------------
EMAIL_SENDER_DOMAIN=""
EMAIL_FROM_ADDRESS=""

# ---------------------------------------------------------------------------
# Scheduled jobs — bearer secret for /api/public/hooks/* endpoints
# ---------------------------------------------------------------------------
LOVABLE_CRON_SECRET="<generate a long random string>"
# LOVABLE_CRON_SECRET_PREVIOUS=""

# ---------------------------------------------------------------------------
# Library discovery integration (optional)
# ---------------------------------------------------------------------------
LIBRARY_API_KEY=""
LIBRARY_API_CLIENT_ID=""
LIBRARY_API_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Seeded staff/student accounts helper (optional, non-production)
# ---------------------------------------------------------------------------
ENABLE_DEMO_ACCESS="false"
DEMO_ACCESS_CODE=""
DEMO_STAFF_PASSWORD=""

# ---------------------------------------------------------------------------
# Embeddings (optional overrides used by scripts/rebuild-embeddings.mjs)
# Defaults to the Lovable AI Gateway with openai/text-embedding-3-small.
# ---------------------------------------------------------------------------
# EMBEDDING_ENDPOINT="https://api.openai.com/v1/embeddings"
# EMBEDDING_MODEL="text-embedding-3-small"
