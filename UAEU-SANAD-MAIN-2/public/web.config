<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <!-- Do not expose source-control, runtime, or operating-system probes. -->
    <!-- Reject legacy and system probes without affecting application routes. -->
    <!-- Voice chat: in-page Arabic speech engine files served from /voice. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".onnx" />
      <mimeMap fileExtension=".onnx" mimeType="application/octet-stream" />
      <remove fileExtension=".data" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />
    </staticContent>
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
        <!-- Reject IIS path-normalization ambiguity such as /auth/..;/auth/. -->
        <denyUrlSequences>
          <add sequence="..;" />
        </denyUrlSequences>
        <verbs>
          <remove verb="TRACE" />
          <remove verb="OPTIONS" />
          <add verb="TRACE" allowed="false" />
          <add verb="OPTIONS" allowed="false" />
        </verbs>
        <hiddenSegments>
          <remove segment=".git" />
          <remove segment=".env" />
          <add segment=".git" />
          <add segment=".env" />
          <remove segment="perl" />
          <remove segment="cgi-bin" />
          <add segment="perl" />
          <add segment="cgi-bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' blob: %VITE_CSP_API_ORIGIN%; form-action 'self' %VITE_CSP_API_ORIGIN%; script-src 'self' 'wasm-unsafe-eval' %CSP_SCRIPT_HASHES%; script-src-attr 'none'; style-src 'self' 'unsafe-inline' %VITE_FONT_STYLES_ORIGIN%; font-src 'self' data: %VITE_FONT_FILES_ORIGIN%; img-src 'self' data: blob: %VITE_CSP_API_ORIGIN%; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' %VITE_CSP_API_ORIGIN% %VITE_CSP_WEBSOCKET_ORIGIN%; manifest-src 'self'; upgrade-insecure-requests" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-XSS-Protection" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), geolocation=(), payment=(), usb=(), microphone=(self)" />
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-store" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
