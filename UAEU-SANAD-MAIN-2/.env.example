# Sanadi — environment template. Copy to `.env` and fill in. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Environment identity (leave unset in production)
# TEST turns on the staff "Sanadi Test Environment" banner and blocks email
# and any write to live university/partner systems. See docs/TEST_ENVIRONMENT.md
# ---------------------------------------------------------------------------
# SANADI_ENV="TEST"
# VITE_SANADI_ENV="TEST"

# ---------------------------------------------------------------------------
# Sanadi API (browser + server) — single host; CSP/WebSocket origins are derived
# ---------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:5281"
SANADI_SERVICE_ROLE_KEY="<service role key from Sanadi.Api appsettings ApiKeys:ServiceRoleKey>"

# Optional server override for emails/QR/verification links.
# When unset, VITE_PUBLIC_APP_URL is used.
# PUBLIC_APP_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# AI provider (required for the Assistant, CV parsing, speech-to-text)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_KEY=""
# CUSTOM_LLM_BASE_URL=""
# CUSTOM_LLM_API_KEY=""
# EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------------------
# Email delivery (optional; sends are skipped when unset)
# ---------------------------------------------------------------------------
EMAIL_SENDER_DOMAIN=""
EMAIL_FROM_ADDRESS=""

# ---------------------------------------------------------------------------
# Scheduled jobs — bearer secret for /api/public/hooks/* endpoints
# ---------------------------------------------------------------------------
SANADI_CRON_SECRET="<generate a long random string>"
# SANADI_CRON_SECRET_PREVIOUS=""

# ---------------------------------------------------------------------------
# Library discovery integration (optional)
# ---------------------------------------------------------------------------
LIBRARY_API_KEY=""
LIBRARY_API_CLIENT_ID=""
LIBRARY_API_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Seeded staff/student accounts helper (optional, non-production)
# ---------------------------------------------------------------------------
ENABLE_DEMO_ACCESS="false"
DEMO_ACCESS_CODE=""
DEMO_STAFF_PASSWORD=""

# UI URL configuration — one variable per distinct host/URL
VITE_PUBLIC_APP_URL="http://localhost:8080"
VITE_COLLEGES_URL="https://www.uaeu.ac.ae/en/colleges/"
VITE_FONT_FILES_ORIGIN="https://fonts.gstatic.com"
# Font styles origin is derived from this stylesheet URL.
VITE_FONT_STYLESHEET_URL="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap"
VITE_DOI_BASE_URL="https://doi.org"
VITE_OCLC_OAUTH_BASE_URL="https://oauth.oclc.org"
VITE_EXAMPLE_CATALOGUE_TEMPLATE="https://catalogue.uaeu.ac.ae/record/{id}"

# Hands-free voice chat: avoid automatic microphone gain increases by default.
# true restores the previous request. Reopen the call after a UI restart/rebuild.
# Browser/device support varies; this is not a distance or speaker filter.
VITE_VOICE_AUTO_GAIN_CONTROL="false"

# Automatic interruptions only: require stronger sustained input before server VAD.
# false restores prior interruption sensitivity. Normal listening is unchanged.
VITE_VOICE_CLOSE_INTERRUPTION="true"
# Normalized microphone RMS, not metres. Higher values require louder input.
# Allowed range 0.001–0.2; default 0.02. Test with the actual microphone.
VITE_VOICE_INTERRUPTION_MIN_RMS="0.02"

