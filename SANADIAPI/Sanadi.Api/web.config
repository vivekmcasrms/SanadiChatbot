<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Sanadi.Api.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
      <!-- Preserve JSON errors/challenges written by ASP.NET Core. -->
      <httpErrors errorMode="Custom" existingResponse="PassThrough" />
      <directoryBrowse enabled="false" />
      <security>
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
          <verbs><remove verb="TRACE" /><add verb="TRACE" allowed="false" /></verbs>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-XSS-Protection" />
          <remove name="X-Powered-By" />
          <remove name="X-AspNet-Version" />
          <remove name="X-AspNetMvc-Version" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
