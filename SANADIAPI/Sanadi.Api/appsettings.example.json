{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SqlServer": {
    "ConnectionString": "Server=localhost;Database=Sanadi;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Sanadi.Api",
    "Audience": "Sanadi.Web",
    "SigningKey": "replace-with-a-long-random-secret",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "ApiKeys": {
    "PublishableKey": "replace-locally",
    "ServiceRoleKey": "replace-locally"
  },
  "Storage": {
    "RootPath": "App_Data/storage",
    "PublicBaseUrl": "http://localhost:5281"
  },
  "Documents": {
    "PublicAppUrl": "http://localhost:8080",
    "BrandColor": "#C8102E"
  },
  "Cors": {
    "Origins": [
      "http://localhost:8080"
    ]
  }
}
